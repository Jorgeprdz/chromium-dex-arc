# Archium for Android: build in a complete checkout after applying the patches.
target_os = "android"
target_cpu = "arm64"
is_desktop_android = true
is_debug = false
is_official_build = true
is_component_build = false
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0
chrome_pgo_phase = 0
use_remoteexec = false
chrome_public_manifest_package = "app.archium.android"
enable_archium_local_passwords = true
