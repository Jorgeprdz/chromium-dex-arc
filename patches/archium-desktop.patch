+
+    private void restoreFrameGeometry() {
+        clearFrameGeometry();
+        mCompositorViewHolder.removeTouchEventObserver(mArcTouchEventObserver);
+        mCompositorViewHolder.removeOnLayoutChangeListener(mContentLayoutListener);
+    }
