+  auto stale = db_->ApplyImportedLogins(rows, snapshot->revision);
+  ASSERT_FALSE(stale.has_value());
+  EXPECT_EQ(ArchiumImportFailure::kStale, stale.error());
+  EXPECT_EQ(0, RowCount());
+}
