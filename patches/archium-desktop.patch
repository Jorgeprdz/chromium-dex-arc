+// One implementation serves both the live presenter cache and import snapshots.
+// Exact matches keep their upstream precedence even if another matching form
+// has a different password.
+template <typename Range, typename Projection>
+password_manager::SavedPasswordsPresenter::AddResult EvaluateAddResult(
+    const password_manager::CredentialUIEntry& credential,
+    const Range& credentials,
+    Projection project) {
+  using AddResult = password_manager::SavedPasswordsPresenter::AddResult;
+  if (!password_manager::IsValidPasswordURL(credential.GetURL()) ||
+      credential.password.empty()) {
+    return AddResult::kInvalid;
+  }
+  bool profile = false;
+  bool account = false;
+  bool exact = false;
+  for (const auto& value : credentials) {
+    const password_manager::StoredCredential& entry = project(value);
+    if (credential.GetFirstSignonRealm() != entry.signon_realm ||
+        credential.username != entry.username_value) {
+      continue;
+    }
+    profile |= entry.IsUsingProfileStore();
+    account |= entry.IsUsingAccountStore();
+    exact |= credential.password == entry.password_value;
+  }
+  if (!profile && !account) {
+    return AddResult::kSuccess;
+  }
+  if (exact) {
+    return AddResult::kExactMatch;
+  }
+  if (!profile) {
+    return AddResult::kConflictInAccountStore;
+  }
+  if (!account) {
+    return AddResult::kConflictInProfileStore;
+  }
+  return AddResult::kConflictInProfileAndAccountStore;
+}
