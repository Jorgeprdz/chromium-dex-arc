+        mPanel.setPadding(dp(8), dp(4), dp(8), dp(8));
+        mSurface.setCornerRadius(dp(16)); mPanel.setBackground(mSurface);
+        mPanel.setElevation(dp(12)); mPanel.setClickable(true);
