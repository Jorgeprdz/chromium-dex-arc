+void RequestDesktopSiteWebContentsObserverAndroid::ReadyToCommitNavigation(
+    content::NavigationHandle* navigation_handle) {
+  if (!navigation_handle->IsInOutermostMainFrame() ||
+      navigation_handle->IsSameDocument()) {
+    return;
+  }
+  // Apply after redirects (runtime overrides are cleared on redirect). Keep the
+  // process-wide Android default untouched, so phone documents do not expose the
+  // API. The upstream Activity, origin checks, system permissions and user gesture
+  // checks remain responsible for opening a real same-origin PiP WebContents.
+  navigation_handle->GetMutableRuntimeFeatureStateContext()
+      .SetDocumentPictureInPictureAPIEnabled(
+          Java_ArcDesktopPolicyBridge_isArchiumDocumentPipEnabled(
+              base::android::AttachCurrentThread(),
+              web_contents()->GetJavaWebContents()));
 }

