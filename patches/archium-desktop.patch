+                    new LayoutParams(-1, dp(ArcDesktopPolicy.ARC_NAV_ROW_HEIGHT_DP)));
+        }
+        for (ArcSidebarState.Entry entry : state.entries(state.selectedSpace())) {
+            if (!java.util.Objects.equals(entry.folderId, mOpenFolder)) continue;
