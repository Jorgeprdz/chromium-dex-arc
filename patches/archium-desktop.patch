+        mHeader.removeView(mHolder); mHeader.addView(mHolder, 0, new LinearLayout.LayoutParams(0, -1, 1));
+        mEditor.setHint(mPlaceholder); mEditor.addTextChangedListener(mTextWatcher);
+        resize();
