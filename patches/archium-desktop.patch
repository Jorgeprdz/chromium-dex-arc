+    }
+
+    private void showSpaces() {
+        if (mDestroyed) return;
+        ArcSidebarState state = mController.state();
+        List<ArcSidebarState.Space> spaces = state.spaces();
+        PopupMenu menu = new PopupMenu(mActivity, mSpace);
+        mMenu = menu;
