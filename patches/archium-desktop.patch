+        hex().setText("#wrong");
+        assertFalse(mDialog.getButton(AlertDialog.BUTTON_POSITIVE).isEnabled());
+        assertFalse(tagged("arc-color-preset:1").isSelected());
+        assertEquals(0xff123456, mPreferences.getInt(ArcDesktopAppearance.COLOR_KEY, 0));
+    }
