+        Bitmap frame=Bitmap.createBitmap(2,2,Bitmap.Config.ARGB_8888);
+        backdrop.setFrame(frame,new Rect(0,0,200,100),new Rect(100,0,200,100));
+        class RecordingCanvas extends Canvas {
+            int rectangles,firstAlpha;
