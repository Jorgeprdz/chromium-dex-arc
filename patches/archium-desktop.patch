+void CompositorView::CopyArcPhoneBackdrop(
+    JNIEnv* env, const JavaRef<jobject>& jweb_contents,
+    int32_t x, int32_t y, int32_t source_width, int32_t source_height,
+    int32_t width, int32_t height, const JavaRef<jobject>& callback) {
+  auto* contents = content::WebContents::FromJavaWebContents(jweb_contents);
+  auto* view = contents ? contents->GetRenderWidgetHostView() : nullptr;
+  gfx::Rect region(x, y, source_width, source_height);
+  if (!view || !view->GetNativeView() || !view->IsSurfaceAvailableForCopy() || region.IsEmpty() ||
+      width <= 0 || height <= 0 || width > 256 || height > 128 ||
+      !gfx::Rect(view->GetNativeView()->GetSizeDevicePx()).Contains(region)) {
+    base::android::RunObjectCallbackAndroid(callback, base::android::ScopedJavaLocalRef<jobject>());
+    return;
+  }
+  // Uses the existing web-content readback path, including its protected-content policy.
+  // No capturer count, surface switch, whole-page bitmap or native toolbar texture.
+  view->CopyFromSurface(region, gfx::Size(width, height), base::Milliseconds(250),
+      base::BindPostTaskToCurrentDefault(base::BindOnce(
+          [](base::android::ScopedJavaGlobalRef<jobject> cb,
+                        const content::CopyFromSurfaceResult& result) {
+        base::android::ScopedJavaLocalRef<jobject> bitmap;
+        if (result.has_value() && !result->bitmap.drawsNothing()) {
+          bitmap = gfx::ConvertToJavaBitmap(result->bitmap, gfx::OomBehavior::kReturnNullOnOom);
+        }
+        base::android::RunObjectCallbackAndroid(cb, bitmap);
+      }, base::android::ScopedJavaGlobalRef<jobject>(env, callback))));
+}
