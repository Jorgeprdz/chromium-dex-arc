+    JNIEnv* env, int32_t request, int64_t id) {
+#if BUILDFLAG(ENABLE_ARCHIUM_LOCAL_PASSWORDS)
+  if (!Operational()) {
+    Java_ArchiumPasswordManagerBridge_onOperation(env, peer_, request, kUnavailable);
+    return;
