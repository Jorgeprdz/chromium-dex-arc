+        if (mFrameRoot != null && mFrameRoot.getBackground() != mDesktopFrameMaterial) {
+            mFrameRoot.setBackground(mDesktopFrameMaterial);
+        }
+    }
+
+    private void clearFrameGeometry() {
+        mFrameDispatch.cancel();
