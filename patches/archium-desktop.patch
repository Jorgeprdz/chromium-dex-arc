+void PasswordStore::GetImportSnapshot(ArchiumImportSnapshotReply callback) {
+  DCHECK(main_task_runner_->RunsTasksInCurrentSequence());
+  if (!backend_) {
+    std::move(callback).Run(base::unexpected(PasswordStoreBackendError(
+        PasswordStoreBackendErrorType::kUncategorized)));
+    return;
+  }
+  if (post_init_callback_) {
+    post_init_callback_ = std::move(post_init_callback_)
+        .Then(base::BindOnce(&PasswordStore::GetImportSnapshot,
+                            weak_ptr_factory_.GetWeakPtr(), std::move(callback)));
+    return;
+  }
+  backend_->GetImportSnapshotAsync(base::BindOnce(
+      &PasswordStore::OnImportSnapshot, weak_ptr_factory_.GetWeakPtr(),
+      std::move(callback)));
+}
+
+void PasswordStore::OnImportSnapshot(ArchiumImportSnapshotReply callback,
+                                    ArchiumImportSnapshotResult result) {
+  DCHECK(main_task_runner_->RunsTasksInCurrentSequence());
+  std::move(callback).Run(std::move(result));
+}
+
+void PasswordStore::ImportLoginsAtomically(
+    std::vector<StoredCredential> credentials,
+    ImportCompletion completion,
+    std::optional<ArchiumPasswordImportRevision> expected_revision) {
+  DCHECK(main_task_runner_->RunsTasksInCurrentSequence());
+  if (!backend_) {
+    std::move(completion).Run(base::unexpected(ArchiumImportFailure::kUnavailable));
+    return;
+  }
+  if (post_init_callback_) {
+    post_init_callback_ = std::move(post_init_callback_)
+        .Then(base::BindOnce(&PasswordStore::ImportLoginsAtomically,
+                             weak_ptr_factory_.GetWeakPtr(),
+                             std::move(credentials), std::move(completion),
+                             expected_revision));
+    return;
+  }
+  backend_->ImportLoginsAtomicallyAsync(
+      std::move(credentials),
+      base::BindOnce(&PasswordStore::OnImportedLogins,
+                     weak_ptr_factory_.GetWeakPtr(), std::move(completion)),
+      expected_revision);
+}
+
+void PasswordStore::OnImportedLogins(
+    ImportCompletion completion,
+    ArchiumImportChangesResult result) {
+  DCHECK(main_task_runner_->RunsTasksInCurrentSequence());
+  if (!result.has_value()) {
+    std::move(completion).Run(base::unexpected(std::move(result).error()));
+    return;
+  }
+  // A missing changelist cannot confirm a transaction committed.
+  if (!result->has_value()) {
+    std::move(completion).Run(base::unexpected(ArchiumImportFailure::kWriteFailed));
+    return;
+  }
+  // Do not emit a spurious password change notification for an authenticated
+  // no-op import. The backend has still validated the expected revision and
+  // successfully committed its zero-write transaction.
+  if (!result->value().empty()) {
+    NotifyLoginsChangedOnMainSequence(
+        LoginsChangedTrigger::Addition,
+        base::expected<std::optional<PasswordStoreChangeList>, PasswordStoreBackendError>(
+            std::move(result).value()));
+  }
+  std::move(completion).Run(base::ok());
+}
