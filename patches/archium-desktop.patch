+        mPlacement = placement; mViewport = viewport; mBeginInput = beginInput;
+        mEndInput = endInput; mRestore = restore; mResults = results;
+        mPlaceholder = placeholder; mActionsLabel = actionsLabel;
+        mOverlay = new FrameLayout(activity) {
