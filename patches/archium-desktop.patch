+std::optional<ArchiumPasswordImportRevision> LoginDatabase::ReadImportRevision() {
+  sql::Statement changes(db_.GetUniqueStatement("SELECT total_changes()"));
+  sql::Statement version(db_.GetUniqueStatement("PRAGMA data_version"));
+  if (!changes.Step() || !version.Step()) return std::nullopt;
+  return ArchiumPasswordImportRevision{archium_import_session_,
+                                      changes.ColumnInt64(0), version.ColumnInt64(0)};
+}
+
+ArchiumImportSnapshotResult LoginDatabase::GetImportSnapshot() {
+  auto failure = [] {
+    return base::unexpected(PasswordStoreBackendError(
+        PasswordStoreBackendErrorType::kUncategorized));
+  };
+  if (is_account_store_.value() || !encryptor_ ||
+      !encryptor_->IsEncryptionAvailable()) return failure();
+  sql::Transaction transaction(&db_);
+  if (!transaction.Begin()) return failure();
+  ArchiumPasswordImportSnapshot snapshot;
+  if (GetAllLogins(&snapshot.credentials) != FormRetrievalResult::kSuccess) {
+    return failure();
+  }
+  auto revision = ReadImportRevision();
+  if (!revision || !transaction.Commit()) return failure();
+  snapshot.revision = *revision;
+  return std::move(snapshot);
+}
+
+base::expected<PasswordStoreChangeList, ArchiumImportFailure>
+LoginDatabase::ApplyImportedLogins(
+    const std::vector<StoredCredential>& credentials,
+    std::optional<ArchiumPasswordImportRevision> expected_revision) {
+  auto failure = [] { return base::unexpected(ArchiumImportFailure::kWriteFailed); };
+  // This operation is exclusively for the local profile vault; account-store
+  // callers must never import into a synchronized backend through this API.
+  if (is_account_store_.value() || !encryptor_ ||
+      !encryptor_->IsEncryptionAvailable()) {
+    return base::unexpected(ArchiumImportFailure::kUnavailable);
+  }
+  sql::Transaction transaction(&db_);
+  if (!transaction.Begin()) {
+    return failure();
+  }
+  // Check on the DB sequence, inside the same transaction as the writes.
+  // A queued web save must never be overwritten using an older preview.
+  if (expected_revision) {
+    // Pin a SQLite read snapshot before checking the revision. A concurrent
+    // external writer must either be detected or make the write upgrade fail.
+    sql::Statement snapshot_lock(
+        db_.GetUniqueStatement("SELECT COUNT(*) FROM logins"));
+    if (!snapshot_lock.Step()) return failure();
+    auto current_revision = ReadImportRevision();
+    if (!current_revision) return failure();
+    if (*current_revision != *expected_revision) {
+      // The read lock and transaction remain held through this decision.
+      // Abort without executing AddLogin or emitting observer notifications.
+      return base::unexpected(ArchiumImportFailure::kStale);
+    }
+  }
+  PasswordStoreChangeList committed_changes;
+  for (const auto& credential : credentials) {
+    AddCredentialError error = AddCredentialError::kNone;
+    auto changes = AddLogin(CloneStoredCredential(credential), &error);
+    if (error != AddCredentialError::kNone || changes.empty()) {
+      return failure();  // Transaction destructor rolls back every row.
+    }
+    committed_changes.insert(committed_changes.end(),
+                             std::make_move_iterator(changes.begin()),
+                             std::make_move_iterator(changes.end()));
+  }
+  if (!transaction.Commit()) {
+    return failure();
+  }
+  return committed_changes;
 }

