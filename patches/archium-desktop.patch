+            CreateLoginDatabase(kProfileStore, directory_.GetPath(), &prefs_),
+            syncer::WipeModelUponSyncDisabledBehavior::kNever, &prefs_,
+            crypt_.get(), nullptr));
+    store_->Init();
+  }
+
+  void Reopen(scoped_refptr<os_crypt_async::Encryptor> encryptor) {
