+    @Before public void setUp() {
+        mActivityController = Robolectric.buildActivity(Activity.class).setup();
+        mActivity = mActivityController.get();
+        mHolder = new FrameLayout(mActivity);
+        mBar = new NativeTouchLocationBar(mActivity);
